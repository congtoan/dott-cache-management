#!/bin/bash
# dott-prefork: bộ chuyển lệnh của root trên VPS chính. Cài ở /usr/local/sbin/dott-prefork (root, 755).
#
#   printf '/tttest/abc/\n' | dott-prefork php81.congtoan.net [--no-delete | --delete-only]
#   <danh sách path cần giữ> | dott-prefork <domain> --purge-cache [--all] [--dry-run]   (dọn cache cũ, mồ côi, mobile)
#   dott-prefork <domain> --export-urls [--since=UNIX]                                  (danh sách URL)
#   dott-prefork <domain> --export-urls --ids=1:p123,1:t:category:5                      (trạng thái bài / term vừa đổi)
#
# Bộ chuyển lệnh này chỉ có 4 việc:
#   1. tra domain → user và thư mục site theo danh sách cố định bên dưới;
#   2. giữ khóa chung cho MỌI site, vì chúng dùng chung 1 vCPU, nên mỗi lúc chỉ một lô chạy;
#   3. hạ ưu tiên CPU và ổ đĩa (nice, ionice);
#   4. chạy prefork-render.php của chính site đó, BẰNG USER CỦA SITE.
# Mọi logic (lọc path, xóa cache cũ, chia blog, render) nằm trong prefork-render.php, tức là nằm
# trong website (wp-content/mu-plugins/dott-cache/), được backup cùng website.
# Site có sửa file PHP đó thì file cũng chỉ chạy bằng quyền của site: không có đường leo lên root.
# Sau này key SSH riêng của service sẽ bị khóa vào lệnh này (command= trong authorized_keys).
set -uo pipefail

site="${1:-}"
case "$site" in
  php81.congtoan.net) user=php81conZSI; root=/home/php81conZSI/php81.congtoan.net/public_html ;;
  diaocthongthai.com) user=diaocthDP4f; root=/home/diaocthDP4f/diaocthongthai.com/public_html ;;  # bật 28/11 (P1)
  *) echo "# domain không được phép: '$site'"; echo "DONE ok=0 fail=0 skip=0"; exit 2 ;;
esac
shift

extra=()
export_urls=0
ids=0
for a in "$@"; do
  case "$a" in
    --no-delete|--delete-only|--purge-cache|--all|--dry-run|--keep-orphans) extra+=("$a") ;;
    --export-urls) export_urls=1 ;;
    --ids=*) [[ "$a" =~ ^--ids=[0-9]+:(p[0-9]+|t:[a-z0-9_-]+:[0-9]+)(,[0-9]+:(p[0-9]+|t:[a-z0-9_-]+:[0-9]+))*$ ]] && { extra+=("$a"); ids=1; } ;;
    --replace) ;; # xử lý ở dưới
    --since=[0-9]*) [[ "$a" =~ ^--since=[0-9]+$ ]] && extra+=("$a") ;;
    --terms=*) [[ "$a" =~ ^--terms=[0-9]+:[a-z0-9_-]+:[0-9]+(,[0-9]+:[a-z0-9_-]+:[0-9]+)*$ ]] && extra+=("$a") ;;
    --max-load=*|--resume-load=*) [[ "$a" =~ ^--(max|resume)-load=[0-9]+(\.[0-9]+)?$ ]] && extra+=("$a") ;;
    --loadavg) echo "LOAD $(cut -d' ' -f1 /proc/loadavg) $(nproc)"; exit 0 ;;
    *) echo "# bỏ qua tham số không được phép: $a" ;;
  esac
done

# --replace: sửa nội dung / version trong file cache (replace-cache.php), không nạp WordPress.
# Job (JSON) và danh sách path đi qua stdin, nên chuỗi tìm/thay không bao giờ đi qua shell.
for a in "$@"; do
  if [ "$a" = "--replace" ]; then
    script="$root/wp-content/mu-plugins/dott-cache/replace-cache.php"
    [ -f "$script" ] || { echo "# thiếu $script"; echo "DONE ok=0 fail=0 skip=0"; exit 2; }
    exec 9>/run/dott-prefork.lock
    flock -w 900 9 || { echo "# đang có lô khác chạy quá 15 phút, bỏ"; echo "DONE ok=0 fail=0 skip=0"; exit 3; }
    nice -n 10 ionice -c2 -n7 runuser -u "$user" -- php "$script" --root="$root" --host="$site" 2>&1
    exit 0
  fi
done

# --export-urls: in danh sách URL của site (export-urls.php), chỉ đọc DB.
# Giữ khóa chung, vì export toàn bộ tốn CPU giống một lô prefork. Riêng --ids (vài bài vừa đổi, gọi
# ngay khi có sự kiện) thì nhẹ: không chờ khóa, để sự kiện không kẹt sau một lô prefork.
if [ "$export_urls" = 1 ]; then
  script="$root/wp-content/mu-plugins/dott-cache/export-urls.php"
  [ -f "$script" ] || { echo "# thiếu $script"; echo "DONE blogs=0 urls=0"; exit 2; }
  if [ "$ids" = 0 ]; then
    exec 9>/run/dott-prefork.lock
    flock -w 900 9 || { echo "# đang có lô khác chạy quá 15 phút, bỏ"; echo "DONE blogs=0 urls=0"; exit 3; }
  fi
  nice -n 10 ionice -c2 -n7 runuser -u "$user" -- php "$script" --root="$root" --host="$site" "${extra[@]}" 2>/dev/null
  exit 0
fi

script="$root/wp-content/mu-plugins/dott-cache/prefork-render.php"
if [ ! -f "$script" ]; then
  echo "# thiếu $script"; echo "DONE ok=0 fail=0 skip=0"; exit 2
fi

# --delete-only chỉ xóa file, không nạp WordPress, gần như không tốn CPU, nên không chờ khóa.
# Nhờ vậy renew vài URL bằng HTTP không bị kẹt sau một lô prefork lớn.
case " ${extra[*]:-} " in
  *" --delete-only "*) ;;
  *)
    exec 9>/run/dott-prefork.lock
    if ! flock -w 900 9; then
      echo "# đang có lô khác chạy quá 15 phút, bỏ"; echo "DONE ok=0 fail=0 skip=0"; exit 3
    fi ;;
esac

# stdin (danh sách path) được chuyển thẳng cho PHP.
nice -n 10 ionice -c2 -n7 runuser -u "$user" -- php "$script" \
  --root="$root" --host="$site" --urls=- --parallel=1 --readonly "${extra[@]}" 2>&1 \
  | grep --line-buffered -v -e 'wpdb must set' -e '^[[:space:]]*$'
exit "${PIPESTATUS[0]}"
